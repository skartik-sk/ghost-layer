{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "ok",
    "valid"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "ok": {
      "type": "boolean"
    },
    "valid": {
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    },
    "txid": {
      "type": "string"
    },
    "height": {
      "type": "integer"
    },
    "pool": {
      "type": "string"
    },
    "action_index": {
      "type": "integer"
    },
    "recipient": {
      "type": "string"
    },
    "value_zat": {
      "type": "integer"
    },
    "memo": {
      "type": "string"
    },
    "msg": {
      "type": "string"
    },
    "msg_signed": {
      "type": "boolean",
      "description": "false for zecproof1 (label only); true for a zip311 disclosure (covered by the sender's signature)"
    },
    "explorer": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kind": {
      "enum": [
        "zecproof",
        "zip311"
      ],
      "description": "absent means zecproof"
    },
    "spends": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pool",
          "index"
        ],
        "properties": {
          "pool": {
            "type": "string"
          },
          "index": {
            "type": "integer"
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pool",
          "index",
          "recipient",
          "value_zat",
          "memo"
        ],
        "properties": {
          "pool": {
            "type": "string"
          },
          "index": {
            "type": "integer"
          },
          "recipient": {
            "type": "string"
          },
          "value_zat": {
            "type": "integer"
          },
          "memo": {
            "type": "string"
          }
        }
      }
    }
  },
  "title": "ghost --json proof verify",
  "if": {
    "properties": {
      "valid": {
        "const": true
      }
    }
  },
  "then": {
    "required": [
      "txid",
      "height",
      "msg_signed",
      "explorer"
    ],
    "anyOf": [
      {
        "required": [
          "recipient",
          "value_zat",
          "memo"
        ]
      },
      {
        "required": [
          "kind",
          "spends",
          "outputs"
        ],
        "properties": {
          "kind": {
            "const": "zip311"
          }
        }
      }
    ]
  },
  "else": {
    "required": [
      "reason"
    ]
  }
}